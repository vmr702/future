{
    "openapi": "3.0.3",
    "info": {
        "title": "Future App API",
        "description": "Документация API",
        "version": "1.0.0"
    },
    "servers": [
    {
        "url": "http://localhost:8080",
        "description": "Локальный сервер разработки"
    }
    ],
    "paths": {
        "/api/tasks": {
            "get": {
                "tags": ["Tasks"],
                "summary": "Получить список задач",
                "description": "Возвращает страницу задач с категориями и статусами. Можно искать по названию и сортировать по одному или нескольким разрешённым полям.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "on_page",
                        "in": "query",
                        "description": "Количество задач на странице.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Подстрока для поиска в названии задачи. Если параметр не передан или пустой, поиск не применяется.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Список полей сортировки через запятую. Допустимые поля: due_at, created_at, title, priority, status_id, category_id. Сортировка выполняется по возрастанию; id добавляется как дополнительное поле сортировки.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "created_at",
                            "example": "due_at,created_at"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Страница задач успешно получена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedTasks"
                                },
                                "example": {
                                    "current_page": 1,
                                    "data": [
                                        {
                                            "id": 1,
                                            "title": "Подготовить отчёт",
                                            "description": "Квартальный отчёт",
                                            "due_at": null,
                                            "status_id": 1,
                                            "priority": "medium",
                                            "category_id": 2,
                                            "created_at": "2026-10-23T07:35:09.000000Z",
                                            "updated_at": "2026-10-23T07:35:09.000000Z",
                                            "category": {
                                                "id": 2,
                                                "name": "Работа",
                                                "description": "Рабочие задачи"
                                            },
                                            "status": {
                                                "id": 1,
                                                "name": "Не выполнена",
                                                "description": null
                                            }
                                        }
                                    ],
                                    "first_page_url": "/?page=1",
                                    "from": 1,
                                    "last_page": 1,
                                    "last_page_url": "/?page=1",
                                    "next_page_url": null,
                                    "path": "/",
                                    "per_page": 10,
                                    "prev_page_url": null,
                                    "to": 1,
                                    "total": 1
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": ["Tasks"],
                "summary": "Создать задачу",
                "description": "Создаёт задачу. Если priority не передан, используется medium; если status_id не передан, используется статус с ID 1.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["title"],
                                "properties": {
                                    "title": {"type": "string", "maxLength": 255, "example": "Подготовить отчёт"},
                                    "description": {"type": "string", "nullable": true, "example": "Квартальный отчёт"},
                                    "due_at": {"type": "string", "format": "date-time", "nullable": true, "example": "2026-10-31T17:00:00Z"},
                                    "status_id": {"type": "integer", "minimum": 1, "default": 1},
                                    "priority": {"type": "string", "enum": ["low", "medium", "high"], "default": "medium"},
                                    "category_id": {"type": "integer", "minimum": 1, "nullable": true}
                                }
                            },
                            "example": {
                                "title": "Подготовить отчёт",
                                "description": "Квартальный отчёт",
                                "due_at": "2026-10-31T17:00:00Z",
                                "status_id": 1,
                                "priority": "high",
                                "category_id": 2
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Задача создана.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["id", "message"],
                                    "properties": {
                                        "id": {"type": "integer", "example": 42},
                                        "message": {"type": "string", "example": "Задача успешно создана"}
                                    }
                                },
                                "example": {
                                    "id": 42,
                                    "message": "Задача успешно создана"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Переданные данные не прошли проверку.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {"type": "string"}
                                        }
                                    }
                                },
                                "example": {
                                    "errors": {
                                        "title": "Название обязательно и должно содержать не более 255 символов"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/tasks/{id}": {
            "get": {
                "tags": ["Tasks"],
                "summary": "Получить задачу по ID",
                "description": "Возвращает одну задачу вместе с её категорией и статусом.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Идентификатор задачи.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Задача найдена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Task"
                                },
                                "example": {
                                    "id": 1,
                                    "title": "Подготовить отчёт",
                                    "description": "Квартальный отчёт",
                                    "due_at": null,
                                    "status_id": 1,
                                    "priority": "medium",
                                    "category_id": 2,
                                    "created_at": "2026-10-23T07:35:09.000000Z",
                                    "updated_at": "2026-10-23T07:35:09.000000Z",
                                    "category": {
                                        "id": 2,
                                        "name": "Работа",
                                        "description": "Рабочие задачи"
                                    },
                                    "status": {
                                        "id": 1,
                                        "name": "Не выполнена",
                                        "description": null
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Задача с таким ID не найдена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Задача не найдена"
                                        }
                                    }
                                },
                                "example": {
                                    "error": "Задача не найдена"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": ["Tasks"],
                "summary": "Полностью обновить задачу",
                "description": "Полностью заменяет поля задачи. title обязателен; для пропущенных необязательных полей применяются значения по умолчанию, как при создании.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Идентификатор задачи.",
                        "required": true,
                        "schema": {"type": "integer", "minimum": 1}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["title"],
                                "properties": {
                                    "title": {"type": "string", "maxLength": 255},
                                    "description": {"type": "string", "nullable": true},
                                    "due_at": {"type": "string", "format": "date-time", "nullable": true},
                                    "status_id": {"type": "integer", "minimum": 1, "default": 1},
                                    "priority": {"type": "string", "enum": ["low", "medium", "high"], "default": "medium"},
                                    "category_id": {"type": "integer", "minimum": 1, "nullable": true}
                                }
                            },
                            "example": {
                                "title": "Подготовить отчёт",
                                "description": "Квартальный отчёт",
                                "due_at": "2026-10-31T17:00:00Z",
                                "status_id": 1,
                                "priority": "high",
                                "category_id": 2
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Задача обновлена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["message"],
                                    "properties": {
                                        "message": {"type": "string", "example": "Задача успешно обновлена"}
                                    }
                                },
                                "example": {
                                    "message": "Задача успешно обновлена"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Задача с таким ID не найдена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {"type": "string", "example": "Задача не найдена"}
                                    }
                                },
                                "example": {"error": "Задача не найдена"}
                            }
                        }
                    },
                    "422": {
                        "description": "Переданные данные не прошли проверку.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": {"type": "string"}
                                        }
                                    }
                                },
                                "example": {
                                    "errors": {
                                        "title": "Название обязательно и должно содержать не более 255 символов"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": ["Tasks"],
                "summary": "Удалить задачу",
                "description": "Удаляет задачу по идентификатору.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Идентификатор задачи.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Задача успешно удалена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["message"],
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Задача успешно удалена"
                                        }
                                    }
                                },
                                "example": {
                                    "message": "Задача успешно удалена"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Задача с таким ID не найдена.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Задача не найдена"
                                        }
                                    }
                                },
                                "example": {
                                    "error": "Задача не найдена"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PaginatedTasks": {
                "type": "object",
                "properties": {
                    "current_page": {"type": "integer"},
                    "data": {
                        "type": "array",
                        "items": {"$ref": "#/components/schemas/Task"}
                    },
                    "first_page_url": {"type": "string", "nullable": true},
                    "from": {"type": "integer", "nullable": true},
                    "last_page": {"type": "integer"},
                    "last_page_url": {"type": "string", "nullable": true},
                    "next_page_url": {"type": "string", "nullable": true},
                    "path": {"type": "string"},
                    "per_page": {"type": "integer"},
                    "prev_page_url": {"type": "string", "nullable": true},
                    "to": {"type": "integer", "nullable": true},
                    "total": {"type": "integer"}
                }
            },
            "Task": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "title": {"type": "string", "maxLength": 255},
                    "description": {"type": "string", "nullable": true},
                    "due_at": {"type": "string", "format": "date-time", "nullable": true},
                    "status_id": {"type": "integer"},
                    "priority": {"type": "string", "enum": ["low", "medium", "high"]},
                    "category_id": {"type": "integer", "nullable": true},
                    "created_at": {"type": "string", "format": "date-time", "nullable": true},
                    "updated_at": {"type": "string", "format": "date-time", "nullable": true},
                    "category": {"$ref": "#/components/schemas/Category", "nullable": true},
                    "status": {"$ref": "#/components/schemas/Status", "nullable": true}
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "name": {"type": "string"},
                    "description": {"type": "string", "nullable": true}
                }
            },
            "Status": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                    "name": {"type": "string"},
                    "description": {"type": "string", "nullable": true}
                }
            }
        }
    }
}
